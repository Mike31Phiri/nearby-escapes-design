# ═══════════════════════════════════════════════════════════════════
# Dream Stay Builder -- Environment Variables
# ═══════════════════════════════════════════════════════════════════
#
# SECURITY RULES:
#   NEXT_PUBLIC_* = exposed to browser. NEVER put secrets here.
#   No prefix       = server-only (Next.js / NestJS). Safe for secrets.
#
# For local development, copy this file to .env.local and fill in values.
# .env.local is gitignored -- secrets stay local.
# ═══════════════════════════════════════════════════════════════════

# --- Frontend (Next.js) ---
# Public -- safe to expose
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Feature flags
NEXT_PUBLIC_USE_MOCK=true

# --- Backend (NestJS) -- Server-Only ---
# These use process.env.* (no NEXT_PUBLIC_ prefix). Never expose to browser.

# Database
# DATABASE_URL=postgresql://user:password@localhost:5432/dreamstay

# JWT
# JWT_SECRET=your-256-bit-secret-change-me
# JWT_EXPIRES_IN=7d

# DPO Payment Gateway
# Currently exposed as NEXT_PUBLIC_DPO_COMPANY_TOKEN in src/lib/dpo.ts
# Must be moved to server-only when backend is integrated.
# DPO_COMPANY_TOKEN=your-dpo-token-here
# DPO_SERVICE_TYPE_ID=6666

# Email / SMTP
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# Redis
# REDIS_URL=redis://localhost:6379
